{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chatmon notify working --source claude --stdin || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chatmon notify needs-you --source claude --stdin || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chatmon notify done --source claude --stdin || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
