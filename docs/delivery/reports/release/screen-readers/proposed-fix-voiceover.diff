@@ -222,13 +230,42 @@ def test_voiceover_holds_announcements_until_chatmon_is_in_front(qapp, monkeypat
     assert posted == []
     active[0] = True
     queue.state_changed(Qt.ApplicationState.ApplicationActive)  # you came to Chatmon
+    _pump(qapp, 0.1)
