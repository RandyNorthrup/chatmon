diff --git a/tests/test_presence.py b/tests/test_presence.py
index 1860660..5868e44 100644
--- a/tests/test_presence.py
+++ b/tests/test_presence.py
@@ -71,6 +71,26 @@ def test_focus_holds_bubbles_on_windows(monkeypatch):
     assert desk.quiet() == "a presentation"  # what SHQueryUserNotificationState says comes first
 
 
+def test_windows_busy_state_is_not_read_as_quiet():
+    """QUNS_BUSY (2) is what Windows says of Chatmon's own stage, a topmost window over its monitor, for as long as
+    Chatmon runs: taken as "a full-screen app", it held every bubble that came on its own."""
+    assert 2 not in presence._QUNS
+
+
+@windows
+def test_another_apps_full_screen_window_still_holds_bubbles_on_windows(monkeypatch):
+    desk = presence.Desk("windows")
+    try:
+        monkeypatch.setattr(presence, "_win_quiet", lambda: None)
+        monkeypatch.setattr(desk, "_win_focus", lambda: False)
+        monkeypatch.setattr(presence, "_win_full_screen_app", lambda: True)
+        assert desk.quiet() == "a full-screen app"
+        monkeypatch.setattr(presence, "_win_full_screen_app", lambda: False)
+        assert desk.quiet() is None
+    finally:
+        desk.close()
+
+
 @macos
 def test_macos_readings():
     idle = presence._mac_idle()
