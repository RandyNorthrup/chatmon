=== the probe (packaging/macos/entry.py in the copies)
"""A probe in place of Chatmon's entry: what an installer's build finds of Qt's own translations. Windowed, so it
writes to the file in $CHATMON_PROBE_OUT."""
import os
import sys

os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
from PyQt6 import QtCore
from PyQt6.QtWidgets import QApplication

from chatmon import i18n, paths

out = open(os.environ["CHATMON_PROBE_OUT"], "w", encoding="utf-8")
app = QApplication([])
print("frozen:", paths.frozen(), "sys._MEIPASS:", getattr(sys, "_MEIPASS", None), file=out)
print("i18n.LOCALE:", i18n.LOCALE, sorted(p.name for p in i18n.LOCALE.iterdir()), file=out)
print("Qt's own folder (QLibraryInfo):", QtCore.QLibraryInfo.path(QtCore.QLibraryInfo.LibraryPath.TranslationsPath), file=out)
print("folders looked in:", i18n.qt_folders(QtCore), file=out)
print("language:", i18n.setup("de"), file=out)
print("Stop:", i18n._("Stop"), file=out)
print("Cancel:", QtCore.QCoreApplication.translate("QPlatformTheme", "Cancel"), file=out)
translator = i18n._qt_translator
print("Qt translation loaded from:", translator.filePath() if translator is not None else None, file=out)
out.close()
