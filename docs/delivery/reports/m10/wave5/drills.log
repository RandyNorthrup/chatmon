        hooked += [(str(i18n.QT_FROZEN / "qtmultimedia_de.qm"), str(qt / "qtmultimedia_de.qm"), "DATA")]
        own = [("chatmon/locale/chatmon.pot", str(locale / "chatmon.pot"), "DATA"), (str(Path("PyQt6", "Qt6", "plugins", "x.dll")), "x.dll", "BINARY")]
    
