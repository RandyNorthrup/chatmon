=== the probe (packaging/entry.py in the copy)
"""A probe in place of Chatmon's entry: what an installer's build finds of Qt's own translations."""
import os

os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
from PyQt6 import QtCore
from PyQt6.QtWidgets import QApplication

from chatmon import i18n, paths

app = QApplication([])
print("frozen:", paths.frozen())
print("i18n.LOCALE:", i18n.LOCALE, sorted(p.name for p in i18n.LOCALE.iterdir()))
print("Qt's own folder (QLibraryInfo):", QtCore.QLibraryInfo.path(QtCore.QLibraryInfo.LibraryPath.TranslationsPath))
print("folders looked in:", i18n.qt_folders(QtCore))
print("language:", i18n.setup("de"))
print("Stop:", i18n._("Stop"))
print("Cancel:", QtCore.QCoreApplication.translate("QPlatformTheme", "Cancel"))
translator = i18n._qt_translator
print("Qt translation loaded from:", translator.filePath() if translator is not None else None)

=== probe_build.py
import importlib.util
import sys
from pathlib import Path

spec = importlib.util.spec_from_file_location("chatmon_build", Path(__file__).parent / "packaging" / "build.py")
build = importlib.util.module_from_spec(spec)
spec.loader.exec_module(build)
print("qt_translations:", build.qt_translations(), flush=True)
build.nuitka(build.BUILD / "probe", "standalone", "--experimental=force-dependencies-pefile", "--windows-console-mode=force", "--output-filename=probe.exe")
