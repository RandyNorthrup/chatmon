#!/bin/sh
# Chatmon's updater, run as root by pkexec: install-update FILE SHA256SUMS.txt SHA256SUMS.txt.sig
#
# Installs FILE (a .deb or .rpm Chatmon downloaded) only if the release's list of checksums (SHA256SUMS.txt) is
# signed by Chatmon's release key (SHA256SUMS.txt.sig), lists FILE's checksum under a release file's name, and
# that release is newer than the Chatmon installed. All three are copied first into a folder only root can write,
# and checked there by verify-update: Chatmon's own check, from this package's folder, with the release key this
# Chatmon was installed with. Nothing the caller says is taken on trust, and nothing can be swapped between the
# check and the install.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
[ "$(id -u)" = 0 ] || { echo "install-update: run as root, by pkexec" >&2; exit 1; }
[ $# -eq 3 ] || { echo "usage: install-update FILE SHA256SUMS.txt SHA256SUMS.txt.sig" >&2; exit 2; }
file=$1 sums=$2 sig=$3
case $file in
    *.deb) kind=deb ;;
    *.rpm) kind=rpm ;;
    *) echo "install-update: not a .deb or .rpm" >&2; exit 2 ;;
esac
for f in "$file" "$sums" "$sig"; do
    [ -f "$f" ] || { echo "install-update: no such file: $f" >&2; exit 2; }
done

dir=$(mktemp -d /tmp/chatmon-update.XXXXXXXX)  # root's own, mode 700
trap 'rm -rf "$dir"' EXIT
cp -- "$file" "$dir/update.$kind"
cp -- "$sums" "$dir/SHA256SUMS.txt"
cp -- "$sig" "$dir/SHA256SUMS.txt.sig"
# -I: no PYTHON* variables, no user site-packages, not the current folder; -S: not the system's site-packages
# either. verify-update says why when it refuses.
/usr/bin/python3 -I -S /usr/lib/chatmon/verify-update "$kind" "$dir/update.$kind" "$dir/SHA256SUMS.txt" "$dir/SHA256SUMS.txt.sig" >/dev/null || exit 3

if [ $kind = deb ]; then
    [ "$(dpkg-deb --field "$dir/update.deb" Package)" = chatmon ] || { echo "install-update: not Chatmon" >&2; exit 3; }
    apt-get install -y "$dir/update.deb"
else
    [ "$(rpm -qp --queryformat '%{NAME}' "$dir/update.rpm" 2>/dev/null)" = chatmon ] || { echo "install-update: not Chatmon" >&2; exit 3; }
    if command -v dnf >/dev/null; then
        dnf install -y "$dir/update.rpm"
    elif command -v zypper >/dev/null; then  # openSUSE; the package is checked by the signed list, not a GPG key
        zypper --non-interactive install --allow-unsigned-rpm "$dir/update.rpm"
    else
        echo "install-update: no dnf or zypper to install it with" >&2
        exit 4
    fi
fi
