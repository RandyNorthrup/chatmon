[Desktop Entry]
Type=Application
Name=Chatmon
GenericName=Desktop companion
Comment=A little creature on your desktop that answers with your AI and keeps an eye on your coding agents
Exec=chatmon
Icon=io.github.RandyNorthrup.chatmon
Terminal=false
Categories=Utility;
Keywords=penguin;pet;companion;assistant;AI;agent;reminder;timer;
StartupNotify=false
Actions=show;quit;

[Desktop Action show]
Name=Bring out Chatmon
Exec=chatmon

[Desktop Action quit]
Name=Quit Chatmon
Exec=chatmon quit
