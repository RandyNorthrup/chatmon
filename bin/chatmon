#!/usr/bin/env python3
"""Run Chatmon from this folder, without installing it.

Symlink it onto your PATH to use it from anywhere:
    ln -s "$PWD/bin/chatmon" ~/.local/bin/chatmon
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from chatmon.cli import main  # noqa: E402

raise SystemExit(main())
